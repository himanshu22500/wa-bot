# Copy this to `.env` on the host (it is gitignored). Consumed by boot-send.sh.
# Keeps account-specific values out of the public repo.

# Region the instance and resources live in.
AWS_REGION=us-east-1

# SNS topic for send-failure alerts. Leave blank to disable alerts.
# Format: arn:aws:sns:<REGION>:<ACCOUNT_ID>:wa-bot-alerts
SNS_TOPIC_ARN=
